{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPMB Desktop",
  "version": "0.1.1",
  "identifier": "id.schools.spmb.desktop",
  "build": {
    "frontendDist": "../desktop/splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SPMB Desktop",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../desktop/dist/laravel": "laravel",
      "../desktop/dist/seed": "seed",
      "../desktop/runtime/php": "php"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
